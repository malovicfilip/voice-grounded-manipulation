<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vgm_moveit_demo</name>
  <version>0.1.0</version>
  <description>Constrained, MoveIt-planned motions for the voice-grounded manipulation demo.</description>
  <maintainer email="malovicfilip1@gmail.com">malovicfilip</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>isaac_moveit</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_resources_panda_moveit_config</depend>
  <depend>rclcpp</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>topic_based_ros2_control</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
