{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-grounded-manipulation.local/schemas/robot-skill-v1.json",
  "title": "Validated high-level robot skill proposal",
  "allOf": [
  {
    "if": {
      "properties": {
        "skill": {
          "const": "move_named_pose"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "null"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "string"
        },
        "reason": {
          "type": "null"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "open_gripper"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "null"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "close_gripper"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "null"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "pick"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "string"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        },
        "scene_revision": {
          "type": "string"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "inspect"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "string"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        },
        "scene_revision": {
          "type": "string"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "place"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        },
        "scene_revision": {
          "type": "string"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "pick_and_place"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        },
        "scene_revision": {
          "type": "string"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "stop"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "null"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "skill": {
          "const": "refuse"
        }
      }
    },
    "then": {
      "properties": {
        "object_id": {
          "type": "null"
        },
        "target_id": {
          "type": "null"
        },
        "pose_name": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "skill",
    "object_id",
    "target_id",
    "pose_name",
    "reason",
    "scene_revision"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "skill": {
      "type": "string",
      "enum": [
        "move_named_pose",
        "open_gripper",
        "close_gripper",
        "pick",
        "place",
        "pick_and_place",
        "inspect",
        "stop",
        "refuse"
      ]
    },
    "object_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "target_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "pose_name": {
      "type": ["string", "null"],
      "enum": ["ready", "extended", "transport", null]
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 240
    },
    "scene_revision": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{16}$"
    }
  }
}
